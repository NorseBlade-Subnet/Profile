    </div>

    <!-- Status Bar -->
    <div class="sys-footer">
      <span>GRID CONNECTION: <span class="status-online">SECURE</span></span>
      <span>LOC: /SYS/NORSEBLADE</span>
    </div>
  </div>

  <!-- Audio Synthesizer Script for Hover Effects -->
  <script>
    // Web Audio API Synth to play subtle cyberpunk blips without external audio files
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    
    function playBlip() {
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(800, audioCtx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(200, audioCtx.currentTime + 0.05);
      
      gain.gain.setValueAtTime(0.03, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.05);
      
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      
      osc.start();
      osc.stop(audioCtx.currentTime + 0.05);
    }

    document.querySelectorAll('.link-btn').forEach(btn => {
      btn.addEventListener('mouseenter', playBlip);
    });
  </script>
</body>
</html>
